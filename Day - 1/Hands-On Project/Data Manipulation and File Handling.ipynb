    "# Hands-On Project: Data Manipulation and File Handling"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "1aa7e6dc-4851-42a9-9bce-537bd8d8b2cb",
   "metadata": {},
   "outputs": [],
   "source": [
    "with open('numbers.txt','r') as file:\n",
    "    numbers = file.readlines()\n",
    "\n",
    "squared_numbers = [str(int(num.strip()) ** 2) + \"\\n\" for num in numbers]\n",
    "\n",
    "with open('output.txt','w') as file:\n",
    "    file.writelines(squared_numbers)"
   ]
  }
